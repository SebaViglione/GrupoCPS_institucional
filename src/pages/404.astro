---
// Página 404 — solo en español: Netlify sirve dist/404.html para cualquier
// ruta inexistente, sin variante por idioma.
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n';

const t = useTranslations('es');
---

<Base
  locale="es"
  pagePath="/404/"
  title={t.seo.notFound.title}
  description={t.seo.notFound.description}
  noindex
>
  <section class="error-page">
    <div class="error-content">
      <div class="error-code">{t.notFound.code}</div>
      <h1 class="error-title">{t.notFound.title}</h1>
      <p class="error-description">{t.notFound.text}</p>
      <a href="/" class="btn btn-primary">{t.notFound.cta}</a>
    </div>
  </section>
</Base>

<style>
  /* Referencia visual: legacy/404.html, con dos fixes:
     - var(--dark-bg) no existía (bug legacy): acá var(--bg-dark).
     - texto secundario con --text-muted (AA sobre bg oscuro) en vez de --light-gray. */
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--bg-dark) 0%, #1a1f2e 100%);
    color: var(--white);
    text-align: center;
    padding: 2rem;
  }

  .error-content {
    max-width: 600px;
  }

  .error-code {
    font-size: 8rem;
    font-weight: 700;
    color: var(--primary-color);
    line-height: 1;
    margin-bottom: 1rem;
    text-shadow: 0 0 20px rgba(var(--primary-rgb), 0.3);
  }

  .error-title {
    font-size: 2rem;
    margin-bottom: 1rem;
    font-family: var(--font-secondary);
    color: var(--very-light-gray);
  }

  .error-description {
    color: var(--text-muted);
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }
</style>
