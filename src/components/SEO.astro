---
import { localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Ruta sin prefijo de idioma, con barra final: '/', '/obras/', '/estudio/'. */
  pagePath: string;
  title: string;
  description: string;
  ogImage?: string;
  theme?: 'estudio';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  locale,
  pagePath,
  title,
  description,
  ogImage = '/og/preview.jpg',
  theme,
  jsonLd = [],
  noindex = false,
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(localePath(locale, pagePath), site);
const esUrl = new URL(pagePath, site);
const enUrl = new URL(localePath('en', pagePath), site);
const ogImageUrl = new URL(ogImage, site);
const themeColor = theme === 'estudio' ? '#ef8a1e' : '#2199d5';
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}

<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="es" href={esUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={esUrl} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Grupo CPS" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={locale === 'es' ? 'es_UY' : 'en_US'} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<meta name="theme-color" content={themeColor} />
<link rel="icon" href="/assets/images/logos-optimized/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/assets/images/icon-192.png" />
<link rel="manifest" href="/manifest.json" />

{jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
