---
import Icon from './Icon.astro';
import { SITE } from '../lib/site';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// No existe en el diccionario: string de UI accesible (paridad con el legacy "Chat en WhatsApp").
const label = locale === 'es' ? 'Chat en WhatsApp' : 'Chat on WhatsApp';
---

<a
  href={SITE.whatsappUrl}
  class="whatsapp-float"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
>
  <Icon name="whatsapp" size={32} />
</a>
