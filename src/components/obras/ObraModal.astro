---
// Modal de detalle de obra: <dialog> nativo + un <template> por obra con el
// contenido portado del template legacy obras.js:781-894 (clases conservadas).
// El script de página clona el template en .modal-body y le asigna
// id="modalTitle" al h2 clonado (por eso acá el h2 lleva clase, no id).
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import { useTranslations, type Locale } from '../../i18n';
import { obras, obraImage, estadoSlug, localizedObra, type Estado } from '../../lib/obras';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const estadoLabel = (estado: Estado) =>
  estado === 'Completada' ? t.obrasPage.estados.completada : t.obrasPage.estados.en_progreso;
---

<dialog id="obraModal" class="obra-modal" aria-labelledby="modalTitle">
  <div class="modal-content">
    <button type="button" class="modal-close" aria-label={t.common.close}>
      <Icon name="x" />
    </button>
    <div class="modal-body"></div>
  </div>
</dialog>

{
  obras.map((obra) => {
    const loc = localizedObra(obra, locale);
    const videos = obra.videos ?? [];
    const total = obra.imagenes.length + videos.length;
    return (
      <template id={`obra-tpl-${obra.id}`}>
        <div class="modal-header">
          <span class="modal-categoria">{t.categories[obra.categoria]}</span>
          <h2 class="modal-title">{loc.nombre}</h2>
          <div class="modal-cliente">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span>{loc.cliente}</span>
          </div>
        </div>

        <div class="modal-carousel-container">
          <div class="modal-carousel">
            {obra.imagenes.map((img, i) => (
              <div class:list={['modal-carousel-item', { active: i === 0 }]} data-index={i}>
                <Picture
                  src={obraImage(img)}
                  widths={[800, 1200, 1600]}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  sizes="(min-width:1280px) 1200px, 92vw"
                  loading="lazy"
                  alt={`${loc.nombre} — ${i + 1}/${total}`}
                />
              </div>
            ))}
            {videos.map((video, vi) => (
              <div
                class:list={[
                  'modal-carousel-item',
                  { active: obra.imagenes.length === 0 && vi === 0 },
                ]}
                data-index={obra.imagenes.length + vi}
              >
                <video controls preload="none" playsinline src={`/${video}`} />
              </div>
            ))}
          </div>
          {total > 1 && (
            <Fragment>
              <button type="button" class="modal-carousel-prev" aria-label={t.common.previous}>
                <Icon name="chevron-left" />
              </button>
              <button type="button" class="modal-carousel-next" aria-label={t.common.next}>
                <Icon name="chevron-right" />
              </button>
              <div class="modal-carousel-indicators">
                {Array.from({ length: total }, (_, i) => (
                  <button
                    type="button"
                    class:list={['modal-carousel-dot', { active: i === 0 }]}
                    data-index={i}
                    aria-label={`${i + 1} / ${total}`}
                  />
                ))}
              </div>
            </Fragment>
          )}
        </div>

        <div class="modal-description">
          <h3>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" />
              <line x1="16" y1="13" x2="8" y2="13" />
              <line x1="16" y1="17" x2="8" y2="17" />
              <polyline points="10 9 9 9 8 9" />
            </svg>
            {t.obrasPage.modal.description}
          </h3>
          <p>{loc.descripcion}</p>
        </div>

        <div class="modal-details-grid">
          <div class="modal-detail-item">
            <span class="modal-detail-label">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                <polyline points="22 4 12 14.01 9 11.01" />
              </svg>
              {t.obrasPage.modal.estado}
            </span>
            <span class:list={['modal-status-badge', `status-${estadoSlug(obra.estado)}`]}>
              {estadoLabel(obra.estado)}
            </span>
          </div>
          <div class="modal-detail-item">
            <span class="modal-detail-label">
              <Icon name="map-pin" size={16} />
              {t.obrasPage.modal.ubicacion}
            </span>
            <span class="modal-detail-value">{loc.ubicacion}</span>
          </div>
          <div class="modal-detail-item">
            <span class="modal-detail-label">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
              </svg>
              {t.obrasPage.modal.superficie}
            </span>
            <span class="modal-detail-value">{obra.superficie}</span>
          </div>
          <div class="modal-detail-item">
            <span class="modal-detail-label">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
              {t.obrasPage.modal.cliente}
            </span>
            <span class="modal-detail-value">{loc.cliente}</span>
          </div>
        </div>
      </template>
    );
  })
}

<style is:global>
  /* Detalles que el legacy resolvía con estilos inline en obras.js:781-894.
     Global porque el contenido vive en <template> y el svg de <Icon> no
     recibe el scope de este componente. */
  .modal-description h3 {
    color: var(--white);
    margin-bottom: 1rem;
    font-size: 1.3rem;
  }

  .modal-description h3 svg {
    width: 24px;
    height: 24px;
    vertical-align: middle;
    margin-right: 0.5rem;
  }

  .modal-detail-label svg {
    width: 16px;
    height: 16px;
    vertical-align: middle;
    margin-right: 0.5rem;
  }
</style>
