---
import '../styles/estudio.css';
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { useTranslations, localePath, type Locale } from '../i18n';
import { SITE } from '../lib/site';
import { breadcrumbJsonLd } from '../lib/jsonld';
import heroImg from '../assets/estudio/hero-estudio.jpg';
import galiciaImg from '../assets/estudio/edificio-galicia.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Íconos SVG de los 6 pasos, copiados tal cual de legacy/estudio.html.
const stepIcons = [
  // 01 — Asesoramiento inicial
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="22" cy="20" r="8" /><path d="M6 48c0-8.837 7.163-16 16-16h1" /><rect x="30" y="28" width="28" height="20" rx="3" /><path d="M38 48l-4 6 10-6" /><line x1="36" y1="35" x2="52" y2="35" /><line x1="36" y1="41" x2="48" y2="41" /></svg>',
  // 02 — Anteproyecto
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="8" y="8" width="48" height="48" rx="2" /><line x1="8" y1="24" x2="56" y2="24" /><line x1="24" y1="24" x2="24" y2="56" /><path d="M32 36 L44 36 L44 48 L32 48 Z" /><path d="M28 16 L36 16" /><circle cx="16" cy="16" r="3" /></svg>',
  // 03 — Trámites y permisos
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="12" y="8" width="40" height="48" rx="2" /><line x1="20" y1="22" x2="44" y2="22" /><line x1="20" y1="30" x2="44" y2="30" /><line x1="20" y1="38" x2="34" y2="38" /><circle cx="44" cy="46" r="10" fill="none" /><path d="M38 46 L42 50 L50 42" stroke-linecap="round" stroke-linejoin="round" /></svg>',
  // 04 — Proyecto ejecutivo
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 56 L8 16 L20 8 L56 8 L56 48 L44 56 Z" /><path d="M8 16 L44 16 L44 56" /><path d="M20 8 L20 16" /><line x1="16" y1="28" x2="40" y2="28" /><line x1="16" y1="36" x2="40" y2="36" /><line x1="16" y1="44" x2="32" y2="44" /><line x1="16" y1="24" x2="16" y2="48" /><line x1="14" y1="24" x2="18" y2="24" /><line x1="14" y1="48" x2="18" y2="48" /></svg>',
  // 05 — Dirección de obra
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 34 C16 22 48 22 48 34" /><rect x="12" y="34" width="40" height="6" rx="1" /><line x1="32" y1="22" x2="32" y2="14" /><ellipse cx="32" cy="50" rx="12" ry="6" /><circle cx="32" cy="50" r="3" fill="currentColor" stroke="none" /></svg>',
  // 06 — Llave en mano
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="22" cy="26" r="12" /><circle cx="22" cy="26" r="5" /><path d="M30 34 L52 56" stroke-linecap="round" /><line x1="42" y1="46" x2="46" y2="50" /><line x1="48" y1="50" x2="44" y2="54" /></svg>',
];

// La imagen del caso real: alt localizado (no hay clave en el diccionario;
// el copy legacy solo existía en español).
const galiciaAlt =
  locale === 'es'
    ? 'Edificio Galicia - Proyecto integral de Grupo CPS'
    : 'Edificio Galicia - Integrated project by Grupo CPS';

const jsonLd = [
  breadcrumbJsonLd([
    { name: t.nav.inicio, url: `${SITE.url}${localePath(locale, '/')}` },
    { name: t.nav.estudio, url: `${SITE.url}${localePath(locale, '/estudio/')}` },
  ]),
];
---

<Base
  {locale}
  pagePath="/estudio/"
  title={t.seo.estudio.title}
  description={t.seo.estudio.description}
  theme="estudio"
  {jsonLd}
>
  <!-- Hero -->
  <section class="estudio-hero" id="estudioHero">
    <div class="hero-bg">
      <Picture
        src={heroImg}
        widths={[960, 1600, 1920]}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        alt=""
      />
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-subtitle fade-in-up">{t.estudio.hero.subtitle}</p>
      <h1 class="hero-title fade-in-up delay-1">{t.estudio.hero.title}</h1>
      <div class="hero-cta fade-in-up delay-2">
        <a href="#servicios" class="btn btn-primary">{t.estudio.hero.ctaPrimary}</a>
        <a
          href={SITE.edificioGaliciaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary">{t.estudio.hero.ctaSecondary}</a
        >
      </div>
    </div>
    <div class="scroll-indicator">
      <div class="mouse"></div>
      <span>{t.hero.scrollHint}</span>
    </div>
  </section>

  <!-- Servicios - Cascading Zigzag -->
  <section class="estudio-servicios" id="servicios">
    <div class="container">
      <div class="section-header center">
        <span class="section-tag">{t.estudio.hero.ctaPrimary}</span>
        <h2 class="section-title">{t.estudio.servicios.title}</h2>
      </div>

      <div class="servicios-cascade">
        {
          t.estudio.steps.map((step, i) => {
            const isLeft = i % 2 === 0;
            const isFinal = i === t.estudio.steps.length - 1;
            const content = (
              <div class="cascade-content">
                <div class="cascade-number">{step.number}</div>
                <div class="cascade-text">
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </div>
              </div>
            );
            const icon = (
              <div class="cascade-icon-wrapper">
                <Fragment set:html={stepIcons[i]} />
              </div>
            );
            return (
              <>
                {i > 0 && (
                  <div class="cascade-connector">
                    <div class="connector-line" />
                  </div>
                )}
                <div
                  class:list={[
                    'cascade-step',
                    isLeft ? 'cascade-left' : 'cascade-right',
                    isFinal && 'cascade-final',
                  ]}
                >
                  {isLeft ? content : icon}
                  {isLeft ? icon : content}
                </div>
              </>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- CTA - Caso Real: Edificio Galicia -->
  <section class="estudio-cta" id="casoReal">
    <div class="container">
      <div class="cta-wrapper">
        <div class="cta-text">
          <span class="section-tag">{t.estudio.galicia.tag}</span>
          <h2 class="cta-title">{t.estudio.galicia.title}</h2>
          <p class="cta-description">{t.estudio.galicia.description}</p>
          <a
            href={SITE.edificioGaliciaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            <span>{t.estudio.galicia.cta}</span>
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
        <div class="cta-image-wrapper">
          <Image
            src={galiciaImg}
            widths={[600, 900, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
            format="webp"
            loading="lazy"
            alt={galiciaAlt}
          />
          <div class="cta-image-overlay"></div>
          <span class="cta-image-label">Edificio Galicia — Cordón, Montevideo</span>
        </div>
      </div>
    </div>
  </section>
</Base>
